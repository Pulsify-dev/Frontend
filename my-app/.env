# ==============================================
# PULSIFY FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================
# Replace the placeholder values with your actual credentials

# Backend API Configuration
# Replace with your actual backend URL (no trailing slash)
# Example: http://localhost:8000/api or https://api.pulsify.com/api
# For development: use relative URL to go through Vite proxy (avoids CORS)
# For production: use the full URL: https://www.pulsify.page/api
VITE_API_BASE_URL=/api

# Google reCAPTCHA v2 Configuration
# Get your keys from: https://www.google.com/recaptcha/admin
# 
# TESTING KEYS (always pass - use for development only):
#   Site key: 6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
#   Secret key: 6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
#
# Replace with your production keys before deployment!
# NOTE: Your key 6LeDoKssAAAAAHSEnXVEWkpMkkBGlWrTnzfjmA0i needs localhost added in Google reCAPTCHA admin
VITE_RECAPTCHA_SITE_KEY=6LeDoKssAAAAAHSEnXVEWkpMkkBGlWrTnzfjmA0i

# ==============================================
# NOTES:
# - VITE_USE_MOCKS has been removed (mocking removed)
